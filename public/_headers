/assets/*
  Cache-Control: public, max-age=3600, must-revalidate
  Cross-Origin-Resource-Policy: same-origin
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Permitted-Cross-Domain-Policies: none

/downloads/*
  Cache-Control: public, max-age=3600, must-revalidate
  Cross-Origin-Resource-Policy: same-origin
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Permitted-Cross-Domain-Policies: none

# Papers and citations are text. Declare the real type so "VIEW PAPER" renders in a new tab
# instead of downloading. nosniff stays on, so an accurate Content-Type is required for inline
# display; without it these are served as application/octet-stream and the browser must download.
/downloads/*.txt
  Content-Type: text/plain; charset=utf-8

/downloads/*.bib
  Content-Type: text/plain; charset=utf-8

# The bundle is the one file that should always download.
/downloads/selected-work.zip
  Content-Disposition: attachment; filename="cooper-e-selected-work.zip"

/.well-known/*
  Cache-Control: public, max-age=3600, must-revalidate
  Cross-Origin-Resource-Policy: same-origin
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff

/privacy.txt
  Cache-Control: public, max-age=3600, must-revalidate
  Cross-Origin-Resource-Policy: same-origin
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff

/security-policy.txt
  Cache-Control: public, max-age=3600, must-revalidate
  Cross-Origin-Resource-Policy: same-origin
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff

# Root-level readable text. Cloudflare types these from the extension already; declaring it here
# makes it explicit and independent of that default, since nosniff means an inaccurate type turns
# the privacy notice into a download rather than a page.
/privacy.txt
  Content-Type: text/plain; charset=utf-8

/security-policy.txt
  Content-Type: text/plain; charset=utf-8

/robots.txt
  Content-Type: text/plain; charset=utf-8

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
