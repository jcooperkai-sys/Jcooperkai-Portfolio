{
  // Deploy configuration for jcooperkai.com.
  //
  // `vinext deploy` generates this file only when it is absent and preserves it otherwise, so the
  // bindings below survive repeated deploys. It must stay in sync with `localBindingConfig` in
  // vite.config.ts, which is the equivalent for the local dev server — the two are separate paths,
  // and a binding added to only one of them silently does nothing on the other.
  //
  // Having this file at the repo root is also what lets `wrangler <command>` run from here at all;
  // without it wrangler cannot resolve the worker name.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "www",

  // The real domain. `custom_domain: true` makes Cloudflare create and manage the DNS record
  // itself, so there is no CNAME to add by hand and nothing to get out of step with the route.
  //
  // Both spellings are bound. Without the apex, jcooperkai.com resolves to nothing while
  // www works, which is the failure people report as "the site is down".
  "routes": [
    { "pattern": "jcooperkai.com", "custom_domain": true },
    { "pattern": "www.jcooperkai.com", "custom_domain": true }
  ],

  // The workers.dev URL stays enabled deliberately: it is how the site is reachable if the
  // domain is ever misconfigured, and it costs nothing to keep.
  "workers_dev": true,
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  // Edge rate limiting for the two routes that do work per request. These are Cloudflare Rate
  // Limiting bindings rather than counters in the Worker: isolates do not share memory, so an
  // in-process counter would limit nothing. namespace_id is a local label, not an account
  // resource, so these need no dashboard step to become live.
  "ratelimits": [
    {
      // Buddy calls a metered third-party model. Unlimited, one client can exhaust the free-tier
      // quota and take Buddy down for every visitor.
      "name": "BUDDY_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      // Bounds KV write amplification against the free tier's 1,000 writes per day.
      "name": "VISITS_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      // The paper and experiment routes re-read a file through the Worker and buffer it, so every
      // request costs a subrequest and a few hundred KB, unlike a plain static asset.
      "name": "ASSET_LIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      // Image generation runs on Cooper's own single 6GB-VRAM GPU (trump). This is the second
      // layer of defense on top of that box's own tunnel-level rate limit -- this one is per
      // client key rather than per edge colocation, so it actually throttles one abusive visitor
      // instead of everyone sharing a colo.
      "name": "IMAGEGEN_LIMIT",
      "namespace_id": "1004",
      "simple": { "limit": 6, "period": 60 }
    }
  ]
  // The visit counter's store. Created with `wrangler kv namespace create VISITS`.
  // Without it the counter reports a static figure with live:false, which is a supported state.
  ,
  "kv_namespaces": [{ "binding": "VISITS", "id": "5b9ee90ce2b54edc9493f32ec0c2f358" }]
}
