{
  "name": "jcooperkai-portfolio",
  "version": "1.0.0",
  "description": "jcooperkai's personal site.",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "deploy": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext deploy",
    "deploy:check": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext deploy --dry-run",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "oxlint app worker build vite.config.ts next.config.ts tests --deny-warnings",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.3",
    "@cloudflare/workers-types": "^5.20260729.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.35",
    "oxlint": "1.76.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0",
    "vite": "8.1.5",
    "wrangler": "4.145.0"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.4",
    "fflate": "0.8.3"
  },
  "type": "module",
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260930.2": true
  }
}
